# Environment Variables for Frontend

# Firebase Web SDK Configuration (CLIENT-SIDE)
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app
# ⚠️ These are PUBLIC and different from backend Admin SDK credentials

VITE_FIREBASE_API_KEY=AIzaSy...your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=tazat-cleaning.firebaseapp.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
